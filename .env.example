# Copy to .env and edit. Values here are development defaults only.

# Password protecting the Postgres database.
DB_PASSWORD=changeme

# Single password used to sign in to the application.
APP_PASSWORD=changeme

# HS256 signing secret for JWTs. MUST be at least 32 bytes. Change this!
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum

# AI-assisted drafting (ADR-0064), both optional and free-tier - leave blank
# to disable. Groq: https://console.groq.com/keys - OpenRouter (fallback):
# https://openrouter.ai/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
