# Copy to .env and edit. Values here are development defaults only.

# Password protecting the Postgres database.
DB_PASSWORD=changeme

# Accounts are self-registered in the app (the first one becomes ADMIN) -
# there is no shared application password to set here anymore.

# HS256 signing secret for JWTs. MUST be at least 32 bytes. Change this!
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum

# TOTP secret encryption at rest (ADR-0111, mandatory MFA). Change the key in
# production; the salt isn't secret but must stay fixed once any account has
# enrolled TOTP - changing it makes existing secrets undecryptable.
MFA_ENCRYPTION_KEY=dev-mfa-key-change-me-in-production
MFA_ENCRYPTION_SALT=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4

# AI-assisted drafting (ADR-0064), both optional and free-tier - leave blank
# to disable. Groq: https://console.groq.com/keys - OpenRouter (fallback):
# https://openrouter.ai/keys
# Model choice and provider priority are configured in-app (Settings > AI,
# ADR-0065), not here.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Nightly backup snapshots (ADR-0073): a Spring cron "sec min hour dom mon
# dow" for when to snapshot, and how many snapshots to keep. ZIPs land in the
# media volume under backups/.
APP_BACKUP_CRON=0 37 3 * * *
APP_BACKUP_KEEP=7
