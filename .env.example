# Copy to .env and edit. Values here are development defaults only.

# Password protecting the Postgres database (the superuser, used only for
# migrations - see RUNTIME_DB_PASSWORD below).
DB_PASSWORD=changeme

# Password for app_runtime (ADR-0114) - the app's own ordinary, non-superuser
# database role, separate from the migrations-only superuser above. Row-level
# security policies are only enforced for this role; a shared value with
# DB_PASSWORD would still work but changing one without the other is safer
# to reason about, so they're independent secrets.
RUNTIME_DB_PASSWORD=changeme-runtime

# Accounts are self-registered in the app (the first one becomes ADMIN) -
# there is no shared application password to set here anymore.

# HS256 signing secret for JWTs. MUST be at least 32 bytes. Change this!
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum

# TOTP secret encryption at rest (ADR-0111, mandatory MFA). Change the key in
# production; the salt isn't secret but must stay fixed once any account has
# enrolled TOTP - changing it makes existing secrets undecryptable.
MFA_ENCRYPTION_KEY=dev-mfa-key-change-me-in-production
MFA_ENCRYPTION_SALT=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4

# Foundry VTT push integration (ADR-0115): key/salt for encrypting whatever relay
# API key a user enters for their own world - NOT a relay URL or API key itself.
# There is no shared/default Foundry relay; every world's connection (relay URL,
# own API key, clientId) is entered by that account's user. Change the key in
# production; the salt isn't secret but must stay fixed once any world has one
# configured - changing it makes existing keys undecryptable.
FOUNDRY_ENCRYPTION_KEY=dev-foundry-key-change-me-in-production
FOUNDRY_ENCRYPTION_SALT=b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5

# WebAuthn/passkeys (ADR-0111 follow-up). MUST be overridden for any real
# deployment: WEBAUTHN_RP_ID must be a registrable domain suffix of the
# browser's actual hostname (bare host, no scheme/port), and
# WEBAUTHN_ALLOWED_ORIGINS must match the browser's origin *exactly*
# (scheme + host + port, comma-separated if more than one). Getting either
# wrong doesn't error loudly - WebAuthn ceremonies just silently fail.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Campaign Organizer
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3001

# AI-assisted drafting (ADR-0064), both optional and free-tier - leave blank
# to disable. Groq: https://console.groq.com/keys - OpenRouter (fallback):
# https://openrouter.ai/keys
# Model choice and provider priority are configured in-app (Settings > AI,
# ADR-0065), not here.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# "Sign in with Google" (ADR-0113), optional - leave blank to disable (no
# /oauth2/authorization/google, no dependency on real credentials to start
# the app). Create a Web application OAuth 2.0 Client at
# https://console.cloud.google.com/apis/credentials with authorized redirect
# URI <your-origin>/login/oauth2/code/google (http://localhost:3001/login/oauth2/code/google
# for this default local setup).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nightly backup snapshots (ADR-0073): a Spring cron "sec min hour dom mon
# dow" for when to snapshot, and how many snapshots to keep. ZIPs land in the
# media volume under backups/.
APP_BACKUP_CRON=0 37 3 * * *
APP_BACKUP_KEEP=7
