# Copy to .env (in this directory) and edit.

# Registry to pull the combined image from (host:port), and which tag.
REGISTRY_HOST=myserver.example.ts.net:5000
IMAGE_TAG=latest

# Password protecting the Postgres database (the superuser, used only for
# migrations - see RUNTIME_DB_PASSWORD below).
DB_PASSWORD=changeme

# Password for app_runtime (ADR-0114) - the app's own ordinary, non-superuser
# database role, separate from the migrations-only superuser above. Row-level
# security policies are only enforced for this role.
RUNTIME_DB_PASSWORD=changeme-runtime

# Single password used to sign in to the application.
APP_PASSWORD=changeme

# HS256 signing secret for JWTs. MUST be at least 32 bytes. Change this!
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum
